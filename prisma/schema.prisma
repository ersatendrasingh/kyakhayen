generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Recipes {
  id                   String                @id @default(uuid())
  title                String                @db.Text
  slug                 String                @unique
  description          String?               @db.LongText
  imageUrl             String?
  RecipeCategories     RecipeCategories?     @relation(fields: [recipeCategoriesId], references: [id])
  recipeCategoriesId   String?
  recipeDifficultyId   String?
  recipeDifficulty     RecipeDifficulty?     @relation(fields: [recipeDifficultyId], references: [id])
  recipeIngredients    RecipeIngredients[]
  recipeMethods        RecipeMethods[]
  recipeSeasons        RecipeSeasons?        @relation(fields: [recipeSeasonsId], references: [id])
  recipeSeasonsId      String?
  recipeCookingTime    RecipeCookingTime?
  recipeCookingMethods RecipeCookingMethod[]
  recipeCuisine        RecipeCuisines[]
  recipeAllergies      RecipeAllergies[]
  recipePrakriti       RecipePrakriti[]

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeCategories {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  imageUrl String?
  recipe   Recipes[]
}

model Units {
  id                String              @id @default(uuid())
  title             String              @unique
  shortName         String              @unique
  RecipeIngredients RecipeIngredients[]
}

model RecipeIngredients {
  id       String  @id @default(uuid())
  name     String
  quantity Decimal
  notes    String? @db.Text
  unitId   String
  position Int
  unit     Units   @relation(fields: [unitId], references: [id])
  recipeId String
  recipe   Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeMethods {
  id          String  @id @default(uuid())
  title       String  @db.Text
  description String? @db.LongText
  imageUrl    String?
  videoUrl    String?
  position    Int
  notes       String? @db.Text
  recipeId    String
  recipe      Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeDifficulty {
  id      String    @id @default(uuid())
  title   String
  Recipes Recipes[]
}

model RecipeSeasons {
  id      String    @id @default(uuid())
  title   String
  Recipes Recipes[]
}

model RecipeCookingTime {
  id       String  @id @default(uuid())
  prepTime Int
  cookTime Int
  restTime Int
  recipe   Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  @@unique([recipeId])
}

model CookingMethods {
  id                  String                @id @default(uuid())
  title               String
  slug                String                @unique
  imageUrl            String?
  recipeCookingMethod RecipeCookingMethod[]
}

model RecipeCookingMethod {
  id              String @id @default(uuid())
  recipeId        String
  cookingMethodId String

  recipe        Recipes        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookingMethod CookingMethods @relation(fields: [cookingMethodId], references: [id], onDelete: Cascade)
}

model Cuisines {
  id            String           @id @default(uuid())
  title         String
  slug          String           @unique
  imageUrl      String?
  recipeCuisine RecipeCuisines[]
}

model RecipeCuisines {
  id       String @id @default(uuid())
  recipeId String
  cusineId String

  recipe  Recipes  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cuisine Cuisines @relation(fields: [cusineId], references: [id], onDelete: Cascade)
}

model Allergies {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  imageUrl        String?
  recipeAllergies RecipeAllergies[]
}

model RecipeAllergies {
  id        String @id @default(uuid())
  recipeId  String
  allergyId String

  recipe    Recipes   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  allergies Allergies @relation(fields: [allergyId], references: [id], onDelete: Cascade)
}

model Prakriti {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  imageUrl       String?
  recipePrakriti RecipePrakriti[]
}

model RecipePrakriti {
  id         String   @id @default(uuid())
  recipeId   String
  prakritiId String
  recipe     Recipes  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  prakriti   Prakriti @relation(fields: [prakritiId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  phoneNumber           String?                @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  UserRole               @default(USER)
  accounts              Account[]
  isTwoFactorEnabled    Boolean                @default(false)
  twoFactorConfirmation TwoFactorConfirmation?

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Recipes {
  id                   String                 @id @default(uuid())
  title                String                 @db.Text
  slug                 String                 @unique
  description          String?                @db.LongText
  imageUrl             String?
  RecipeCategories     RecipeCategories?      @relation(fields: [recipeCategoriesId], references: [id])
  recipeCategoriesId   String?
  recipeDifficultyId   String?
  recipeSeasonsId      String?
  views                Int                    @default(0)
  recipeDifficulty     RecipeDifficulty?      @relation(fields: [recipeDifficultyId], references: [id])
  recipeIngredients    RecipeIngredients[]
  recipeMethods        RecipeMethods[]
  recipeHealthBenefits RecipeHealthBenefits[]
  recipeSeasons        RecipeSeasons?         @relation(fields: [recipeSeasonsId], references: [id])
  recipeCookingTime    RecipeCookingTime?
  recipeCookingMethods RecipeCookingMethod[]
  recipeCuisine        RecipeCuisines[]
  recipeAllergies      RecipeAllergies[]
  recipePrakriti       RecipePrakriti[]
  recipeHealthGoals    recipeHealthGoals[]
  recipeMealTime       recipeMealTime[]
  recipeDisease        recipeDisease[]
  recipeNutrient       recipeNutrient[]
  recipeDietType       recipeDietType[]
  recipeRecipeType     recipeRecipeType[]
  recipeComments       Comment[]
  Review               Review[]
  RecipeViews          RecipeViews[]
  UserRecipeViews      UserRecipeViews[]
  Favorite             Favorite[]

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeViews {
  id        String  @id @default(uuid())
  ipAddress String
  recipeId  String
  recipe    Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ipAddress])
}

model UserRecipeViews {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipes  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, recipeId])
}

model RecipeCategories {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  imageUrl String?
  position Int?
  recipe   Recipes[]
  User     User[]
}

model Units {
  id                         String                       @id @default(uuid())
  title                      String                       @unique
  shortName                  String                       @unique
  RecipeIngredients          RecipeIngredients[]
  IngredientUnitMeasurements IngredientUnitMeasurements[]
}

model RecipeIngredients {
  id             String          @id @default(uuid())
  ingredientId   String
  ingredient     Ingredients     @relation(fields: [ingredientId], references: [id])
  quantity       Float
  formId         String
  ingredientForm IngredientsForm @relation(fields: [formId], references: [id])
  unitId         String
  position       Int
  unit           Units           @relation(fields: [unitId], references: [id])
  recipeId       String
  recipe         Recipes         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeMethods {
  id          String  @id @default(uuid())
  title       String  @db.Text
  description String? @db.LongText
  imageUrl    String?
  videoUrl    String?
  position    Int
  notes       String? @db.Text
  recipeId    String
  recipe      Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeHealthBenefits {
  id       String  @id @default(uuid())
  title    String  @db.Text
  position Int
  recipeId String
  recipe   Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeDifficulty {
  id       String    @id @default(uuid())
  title    String
  imageUrl String?
  position Int?
  Recipes  Recipes[]
  User     User[]
}

model RecipeSeasons {
  id      String    @id @default(uuid())
  title   String
  Recipes Recipes[]
}

model RecipeCookingTime {
  id       String  @id @default(uuid())
  prepTime Int
  cookTime Int
  restTime Int
  recipe   Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  @@unique([recipeId])
}

model CookingMethods {
  id                  String                @id @default(uuid())
  title               String
  slug                String                @unique
  imageUrl            String?
  recipeCookingMethod RecipeCookingMethod[]
}

model RecipeCookingMethod {
  id              String @id @default(uuid())
  recipeId        String
  cookingMethodId String

  recipe        Recipes        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookingMethod CookingMethods @relation(fields: [cookingMethodId], references: [id], onDelete: Cascade)
}

model Cuisines {
  id            String           @id @default(uuid())
  title         String
  slug          String           @unique
  imageUrl      String?
  recipeCuisine RecipeCuisines[]
  userCuisines  UserCuisines[]
}

model RecipeCuisines {
  id        String @id @default(uuid())
  recipeId  String
  cuisineId String

  recipe  Recipes  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cuisine Cuisines @relation(fields: [cuisineId], references: [id], onDelete: Cascade)
}

model Allergies {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  imageUrl        String?
  recipeAllergies RecipeAllergies[]
  UserAllrgies    UserAllrgies[]
}

model RecipeAllergies {
  id        String @id @default(uuid())
  recipeId  String
  allergyId String

  recipe    Recipes   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  allergies Allergies @relation(fields: [allergyId], references: [id], onDelete: Cascade)
}

model Prakriti {
  id                     String                   @id @default(uuid())
  title                  String
  slug                   String                   @unique
  imageUrl               String?
  recipePrakriti         RecipePrakriti[]
  PrakritiQuestionOption PrakritiQuestionOption[]
  User                   User[]
}

model RecipePrakriti {
  id         String   @id @default(uuid())
  recipeId   String
  prakritiId String
  recipe     Recipes  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  prakriti   Prakriti @relation(fields: [prakritiId], references: [id], onDelete: Cascade)
}

model HealthGoals {
  id                String              @id @default(uuid())
  title             String
  slug              String              @unique
  imageUrl          String?
  recipeHealthGoals recipeHealthGoals[]
  UserHealthGoals   UserHealthGoals[]
}

model recipeHealthGoals {
  id           String      @id @default(uuid())
  recipeId     String
  healthGoalId String
  recipe       Recipes     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  healthGoals  HealthGoals @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)
}

model MealTimes {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  imageUrl       String?
  position       Int?
  recipeMealTime recipeMealTime[]
}

model recipeMealTime {
  id         String    @id @default(uuid())
  recipeId   String
  mealTimeId String
  recipe     Recipes   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealTime   MealTimes @relation(fields: [mealTimeId], references: [id], onDelete: Cascade)
}

model Disease {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  imageUrl      String?
  recipeDisease recipeDisease[]
}

model recipeDisease {
  id        String  @id @default(uuid())
  recipeId  String
  diseaseId String
  recipe    Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  disease   Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
}

model Nutrient {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  imageUrl       String?
  recipeNutrient recipeNutrient[]
}

model recipeNutrient {
  id         String   @id @default(uuid())
  recipeId   String
  nutrientId String
  recipe     Recipes  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade)
}

model DietTypes {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  imageUrl       String?
  recipeDietType recipeDietType[]
}

model recipeDietType {
  id         String    @id @default(uuid())
  recipeId   String
  dietTypeId String
  recipe     Recipes   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dietType   DietTypes @relation(fields: [dietTypeId], references: [id], onDelete: Cascade)
}

model RecipeTypes {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  imageUrl         String?
  recipeRecipeType recipeRecipeType[]
}

model recipeRecipeType {
  id           String      @id @default(uuid())
  recipeId     String
  recipeTypeId String
  recipe       Recipes     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeType   RecipeTypes @relation(fields: [recipeTypeId], references: [id], onDelete: Cascade)
}

model Ingredients {
  id                   String @id @default(uuid())
  name                 String
  calories             Float?
  carbohydrate         Float?
  totalFat             Float?
  dietaryFiber         Float?
  protein              Float?
  vitaminA             Float?
  ascorbicAcids        Float?
  vitaminD             Float?
  tocopherolEquivalent Float?
  vitaminK             Float?
  thiamine             Float?
  riboflavin           Float?
  totalB6              Float?
  folates              Float?
  calcium              Float?
  iron                 Float?
  phophorus            Float?
  potassium            Float?
  sodium               Float?
  zinc                 Float?

  IngredientCategories   IngredientCategories? @relation(fields: [ingredientCategoriesId], references: [id])
  ingredientCategoriesId String?
  RecipeIngredients      RecipeIngredients[]

  isPublished Boolean @default(false)

  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  IngredientUnitMeasurements IngredientUnitMeasurements[]
}

model IngredientUnitMeasurements {
  id           String      @id @default(uuid())
  ingredientId String
  unitId       String
  unit         Units       @relation(fields: [unitId], references: [id])
  ingredient   Ingredients @relation(fields: [ingredientId], references: [id])
  values       Float
}

model IngredientCategories {
  id         String        @id @default(uuid())
  name       String        @unique
  slug       String        @unique
  ingredient Ingredients[]
}

model IngredientsForm {
  id                String              @id @default(uuid())
  name              String              @unique
  RecipeIngredients RecipeIngredients[]
}

model Plan {
  id              String         @id @default(uuid())
  name            String
  slug            String         @default("slug")
  durationMonths  Int?
  regularPriceInr Float?
  regularPriceUsd Float?
  priceInr        Float?
  priceUsd        Float?
  features        Feature[]
  UserPlan        UserPlan[]
  Item            Item[]
  PlanOnCoupon    PlanOnCoupon[]
  isPublished     Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feature {
  id       String @id @default(uuid())
  name     String
  planId   String
  position Int    @default(0)
  plans    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  phoneNumber           String?                @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  bio                   String?                @db.Text
  role                  UserRole               @default(USER)
  accounts              Account[]
  heightFt              Int?
  heightInch            Int?
  heightCm              Int?
  weightKg              Int?
  weightLbs             Int?
  bmi                   Float?
  dob                   DateTime?
  age                   Int?
  genderId              String?
  gender                Gender?                @relation(fields: [genderId], references: [id])
  foodPreferenceId      String?
  foodPreference        RecipeCategories?      @relation(fields: [foodPreferenceId], references: [id])
  cookingSkillId        String?
  cookingSkill          RecipeDifficulty?      @relation(fields: [cookingSkillId], references: [id])
  prakritiId            String?
  userPrakriti          Prakriti?              @relation(fields: [prakritiId], references: [id])
  prakriti              UserPrakriti[]
  userCuisines          UserCuisines[]
  UserAllrgies          UserAllrgies[]
  UserHealthGoals       UserHealthGoals[]
  Post                  Post[]
  Comment               Comment[]
  UserPlan              UserPlan[]
  UserMealPlan          UserMealPlan[]
  isTwoFactorEnabled    Boolean                @default(false)
  isPersonalised        Boolean                @default(false)
  twoFactorConfirmation TwoFactorConfirmation?
  firebaseToken         String?
  CommentLikes          CommentLikes[]
  Review                Review[]
  Favorite              Favorite[]
  UserRecipeViews       UserRecipeViews[]
  UserAddress           UserAddress[]
  Order                 Order[]
  UserCoupon            UserCoupon[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model UserAddress {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  country String
  state   String
  city    String
  address String @db.Text
  zip     String
}

model UserPlan {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id])
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model Gender {
  id       String  @id @default(uuid())
  title    String
  imageUrl String?
  position Int?
  User     User[]
}

model PrakritiQuestion {
  id          String                   @id @default(uuid())
  question    String
  isPublished Boolean                  @default(false)
  options     PrakritiQuestionOption[]
}

model PrakritiQuestionOption {
  id         String            @id @default(uuid())
  value      String
  questionId String
  prakritiId String
  position   Int
  parkriti   Prakriti          @relation(fields: [prakritiId], references: [id])
  question   PrakritiQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([prakritiId])
}

model UserPrakriti {
  id         String @id @default(uuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  prakritiId String
  optionId   String
}

model UserCuisines {
  id        String   @id @default(uuid())
  userId    String
  cuisineId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisine   Cuisines @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@unique([userId, cuisineId])
  @@index([cuisineId])
  @@index([userId])
}

model UserAllrgies {
  id        String    @id @default(uuid())
  userId    String
  allergyId String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergy   Allergies @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@unique([userId, allergyId])
  @@index([allergyId])
  @@index([userId])
}

model UserHealthGoals {
  id           String      @id @default(uuid())
  userId       String
  healthGoalId String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthGoal   HealthGoals @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)

  @@unique([userId, healthGoalId])
  @@index([healthGoalId])
  @@index([userId])
}

model UserMealPlan {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planStartDate   DateTime
  planEndDate     DateTime
  isPlanGenerated Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  MealPlan        MealPlan[]
}

model MealPlan {
  id             String       @id @default(uuid())
  userMealPlanId String
  usermealPlan   UserMealPlan @relation(fields: [userMealPlanId], references: [id])
  date           DateTime
  s3url          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Post {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  content         String?        @db.LongText
  imageUrl        String?
  isPublished     Boolean        @default(false)
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  PostCategory    PostCategory[]
  articleComments Comment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Category {
  id           String         @id @default(uuid())
  title        String         @unique
  slug         String         @unique
  imageUrl     String?
  PostCategory PostCategory[]
}

model PostCategory {
  id         String   @id @default(uuid())
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
}

model Country {
  id          Int     @id @default(autoincrement())
  name        String
  countryCode String
  capital     String?
  region      String?
  currency    String?
  flag        String?
  phoneCode   String?
  states      State[]
}

model State {
  id        Int     @id @default(autoincrement())
  name      String
  stateCode String
  country   Country @relation(fields: [countryId], references: [id])
  countryId Int
  cities    City[]
}

model City {
  id      Int    @id @default(autoincrement())
  name    String
  state   State  @relation(fields: [stateId], references: [id])
  stateId Int
}

model ContactUsQueries {
  id          String   @id @default(cuid())
  name        String
  email       String
  phoneNumber String?
  country     String?
  state       String?
  city        String?
  query       String?  @db.Text
  createdAt   DateTime @default(now())
}

model Comment {
  id              String         @id @default(uuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  content         String         @db.Text
  likes           Int?           @default(0)
  recipe          Recipes?       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId        String?
  Post            Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId          String?
  parentComment   Comment?       @relation("Replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  parentCommentId String?
  replies         Comment[]      @relation("Replies")
  isPrimary       Boolean        @default(true)
  isPublished     Boolean        @default(false)
  CommentLikes    CommentLikes[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommentLikes {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, commentId])
}

model Review {
  id          String  @id @default(uuid())
  rating      Int     @default(1)
  comment     String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  recipe      Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId    String
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id       String  @id @default(uuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  recipe   Recipes @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, recipeId])
}

enum PaymentStatus {
  Processing
  Paid
  Failed
  Success
  Cancelled
}

model Order {
  id            String        @id @default(cuid())
  orderId       String?       @unique
  subTotal      Float?
  taxTotal      Float?
  coupon        String?
  discount      Float?
  totalAmount   Float?
  currency      String?
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  paymentMethod String?
  paymentStatus PaymentStatus @default(Processing)
  items         Item[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Item {
  id       String  @id @default(cuid())
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id])
  itemName String
  quantity Int     @default(1)
  priceInr Float?
  priceUsd Float?
  planId   String?
  plan     Plan?   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  FIXED_PRODUCT
  CART_PERCENTAGE
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(CART_PERCENTAGE)
  discountValue Float?
  expiryDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(false)

  PlanOnCoupon PlanOnCoupon[]
  UserCoupon   UserCoupon[]

  @@index([code])
}

model PlanOnCoupon {
  id       String @id @default(uuid())
  couponId String
  planId   String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan     Plan   @relation(fields: [planId], references: [id])

  @@unique([couponId, planId])
}

model UserCoupon {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Database
# Local Docker example:
# docker run --name kyakhayen-mysql -e MYSQL_ROOT_PASSWORD=kyakhayen_dev_root -e MYSQL_DATABASE=kyakhayen_dev -e MYSQL_USER=kyakhayen -e MYSQL_PASSWORD=kyakhayen_dev_pw -p 3307:3306 -d mysql:8.0
DATABASE_URL="mysql://kyakhayen:kyakhayen_dev_pw@127.0.0.1:3307/kyakhayen_dev"

# Authentication (Auth.js)
AUTH_SECRET=
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM_NAME="Kya Khayen"
EMAIL_FROM_ADDRESS=
ADMIN_EMAIL=

# Media storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_MEDIA_BUCKET_NAME=
AWS_PRIVATE_BUCKET_NAME=
# CloudFront/custom CDN domain backed only by the media bucket
NEXT_PUBLIC_MEDIA_URL=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY=

# Background queues
REDIS_SERVER_HOST=127.0.0.1
REDIS_SERVER_PORT=6379
MEAL_PLAN_WORKER_SECRET=

# Currency conversion
NEXT_PUBLIC_EXCHANGE_API_URL=
NEXT_PUBLIC_FREE_CURRENCY_API_KEY=

# Analytics
GOOGLE_TAG_MANAGER_ID=

# Web push notifications (generate one VAPID key pair and keep the private key server-only)
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
